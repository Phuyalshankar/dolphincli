{
  "name": "dolphincss",
  "version": "1.4.5",
  "type": "module",
  "description": "DolphinCSS - World-class TailwindCSS + React component library",
  "main": "dolphin-css.css",
  "bin": {
    "dolphin-template": "bin/dolphin.js",
    "dolphin-cleanup": "scripts/cleanup-vscode.cjs"
  },
  "exports": {
    ".": "./dolphin-css.css",
    "./dolphin-css.css": "./dolphin-css.css",
    "./vite-plugin": "./vite-plugin.js",
    "./ub": {
      "types": "./src/ub.d.ts",
      "default": "./src/ub.js"
    },
    "./ub/vanilla": {
      "types": "./src/ub-vanilla.d.ts",
      "default": "./src/ub-vanilla.js"
    }
  },
  "files": [
    "dist/",
    "dolphin-css.css",
    "README.md",
    "LICENSE",
    "snippets/",
    "bin/",
    "scripts/",
    "core-templates/",
    "config/",
    "templates/",
    "vite-plugin.js",
    "marker.json",
    "dolphincss-plugin.cjs",
    "src/ub.js",
    "src/ub.d.ts",
    "src/ub-vanilla.js",
    "src/ub-vanilla.d.ts"
  ],
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run watch:dolphin\"",
    "watch:dolphin": "node bin/dolphin.js",
    "build:css": "npx @tailwindcss/cli -i ./src/dolphin-css/App.css -o ./dolphin-css.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/dolphin-css/App.css -o ./dolphin-css.css --watch",
    "build": "vite build && npm run build:css",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node scripts/setup-snippets.cjs",
    "dolphin:cleanup": "node scripts/cleanup-vscode.cjs"
  },
  "keywords": [
    "css",
    "tailwind",
    "react",
    "components",
    "dolphin-theme"
  ],
  "author": "Shankar Phunyal",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/cli": "^4.1.16",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.7"
  }
}
